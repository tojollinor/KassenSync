<Window x:Class="KassenSync.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:KassenSync.App.Controls"
        Title="OrdnerSync" Icon="Assets/OrdnerSync.ico"
        Height="790" Width="1280" MinHeight="650" MinWidth="1040"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="{DynamicResource AppBackgroundBrush}"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <controls:OrdnerSyncLogo Width="44"
                                     Height="44"
                                     Margin="0,0,12,0"/>

            <StackPanel Grid.Column="1">
                <TextBlock Text="OrdnerSync" FontSize="26" FontWeight="SemiBold"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <Ellipse x:Name="ServiceStatusDot" Width="10" Height="10" Fill="Gray" Margin="0,0,7,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ServiceStatusText" Text="Dienststatus wird geprüft …" Foreground="Gray"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                <TextBlock Text="Jobs" Foreground="Gray" HorizontalAlignment="Right"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                    <Ellipse x:Name="JobsStatusDot" Width="10" Height="10" Fill="Gray" Margin="0,0,7,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="JobSummaryText" Text="-" FontWeight="SemiBold"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <TabControl Grid.Row="1"
                    x:Name="MainTabs"
                    Background="{DynamicResource AppBackgroundBrush}">
            <TabItem Header="Dateien">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="260"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" x:Name="RefreshButton" Content="Aktualisieren" Padding="14,7" Margin="0,0,8,0" Click="RefreshButton_Click"/>
                        <Button Grid.Column="1" x:Name="RecopyButton" Content="Erneut verarbeiten" Padding="14,7" Margin="0,0,8,0" Click="RecopyButton_Click"/>
                        <Button Grid.Column="2" x:Name="DeleteIndexedButton" Content="Markierte Einträge löschen" Padding="14,7" Click="DeleteIndexedButton_Click"/>

                        <StackPanel Grid.Column="4"
                                    Grid.ColumnSpan="2"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <TextBlock Text="Job:"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>
                            <ComboBox x:Name="JobFilterComboBox"
                                      Width="260"
                                      Height="30"
                                      DisplayMemberPath="Name"
                                      VerticalContentAlignment="Center"
                                      Padding="6,0,4,0"
                                      Background="White"
                                      SelectionChanged="JobFilterComboBox_SelectionChanged"/>
                        </StackPanel>

                        <TextBlock Grid.Column="7" x:Name="SelectionText" Text="0 Dateien markiert"
                                   VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="Gray"/>
                    </Grid>

                    <DataGrid Grid.Row="1" x:Name="FilesGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="False"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="44">
                                <DataGridTemplateColumn.Header>
                                    <CheckBox x:Name="SelectAllFilesCheckBox"
                                              IsThreeState="True"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              ToolTip="Alle sichtbaren Einträge markieren oder demarkieren"
                                              Checked="SelectAllFilesCheckBox_Checked"
                                              Unchecked="SelectAllFilesCheckBox_Unchecked"/>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Status" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="9" Height="9" Fill="{Binding StatusBrush}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Status}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Job" Binding="{Binding JobName}" Width="140" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Dateiname" Binding="{Binding FileName}" Width="2*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Relativer Pfad" Binding="{Binding RelativePath}" Width="2.2*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Größe" Binding="{Binding Size}" Width="90" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Erkannt" Binding="{Binding DetectedAt}" Width="140" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Zuletzt kopiert" Binding="{Binding LastCopiedAt}" Width="140" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Ausgaben" Binding="{Binding CopyCount}" Width="80" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Fehler" Binding="{Binding Error}" Width="2*" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Jobs">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="430"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Sync-Jobs" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,10"/>

                        <DataGrid Grid.Row="1" x:Name="JobsGrid"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  SelectionMode="Single"
                                  IsReadOnly="False"
                                  GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Status" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="9" Height="9" Fill="{Binding StatusBrush}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Aktiv" Width="55">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Modus" Binding="{Binding ModeText}" Width="110" IsReadOnly="True"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="Job hinzufügen" Padding="14,7" Margin="0,0,8,0" Click="AddJobButton_Click"/>
                            <Button Content="Job löschen" Padding="14,7" Click="DeleteJobButton_Click"/>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Column="2" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="6" Padding="18">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="JobEditor"
                                        DataContext="{Binding SelectedItem, ElementName=JobsGrid}">
                                <TextBlock Text="Job bearbeiten" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16"/>

                                <TextBlock Text="Name" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

                                <CheckBox Content="Job aktiv"
                                          IsChecked="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Margin="0,0,0,16"/>

                                <TextBlock Text="Quelle" Margin="0,0,0,4"/>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding SourceFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    <Button Grid.Column="1" Content="Auswählen …" Padding="12,6" Margin="8,0,0,0" Click="BrowseJobSourceButton_Click"/>
                                </Grid>

                                <TextBlock Text="Zieltyp" Margin="0,0,0,4"/>
                                <ComboBox x:Name="TargetTypeComboBox"
                                          SelectedValue="{Binding TargetType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Margin="0,0,0,12"/>

                                <TextBlock Text="Zielordner / USB-Pfad" Margin="0,0,0,4"/>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding TargetFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    <Button Grid.Column="1" Content="Auswählen …" Padding="12,6" Margin="8,0,0,0" Click="BrowseJobTargetButton_Click"/>
                                </Grid>

                                <TextBlock Text="Richtung" Margin="0,0,0,4"/>
                                <ComboBox x:Name="SyncModeComboBox"
                                          SelectedValue="{Binding Mode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Margin="0,0,0,12"/>

                                <CheckBox Content="Unterordner einbeziehen"
                                          IsChecked="{Binding IncludeSubdirectories, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Margin="0,0,0,12"/>

                                <TextBlock Text="Dateitypen" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding AllowedExtensionsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="Mit Komma trennen, z. B. .pdf, .xml, .csv. Leer = alle Dateitypen."
                                           Foreground="Gray" Margin="0,4,0,18"/>

                                <Button Content="Jobs speichern"
                                        Padding="16,8"
                                        HorizontalAlignment="Left"
                                        Click="SaveJobsButton_Click"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Einstellungen">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18" MaxWidth="900" HorizontalAlignment="Left">
                        <TextBlock Text="Allgemein" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <CheckBox x:Name="AutostartCheckBox"
                                  Content="OrdnerSync-Fenster bei Windows-Anmeldung öffnen"
                                  Margin="0,0,0,4"/>
                        <TextBlock Text="Dieser Schalter betrifft nur die Oberfläche."
                                   Foreground="Gray"
                                   Margin="22,0,0,10"/>
                        <CheckBox x:Name="UpdateCheckBox"
                                  Content="Beim Start der Oberfläche nach Updates suchen"
                                  Margin="0,0,0,18"/>

                        <TextBlock Text="Erfolgsmeldungen" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <TextBlock Text="Fehler bleiben immer sichtbar, bis sie mit OK bestätigt werden."
                                   Foreground="Gray" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ComboBox x:Name="SuccessNotificationModeComboBox"
                                      Grid.Column="0"
                                      Height="30"
                                      VerticalContentAlignment="Center"
                                      SelectionChanged="SuccessNotificationModeComboBox_SelectionChanged"/>

                            <TextBlock Grid.Column="2"
                                       Text="Anzeigedauer:"
                                       VerticalAlignment="Center"/>

                            <TextBox x:Name="SuccessNotificationSecondsTextBox"
                                     Grid.Column="4"
                                     Height="28"
                                     VerticalContentAlignment="Center"
                                     TextAlignment="Right"
                                     Padding="5,0"/>

                            <TextBlock Grid.Column="6"
                                       Text="Sek."
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <TextBlock Text="Darstellung" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <TextBlock Text="Hintergrundfarbe für OrdnerSync-Fenster und Meldungen"
                                   Foreground="Gray"
                                   Margin="0,0,0,8"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,22">
                            <TextBox x:Name="BackgroundColorTextBox"
                                     Width="100"
                                     Height="28"
                                     VerticalContentAlignment="Center"
                                     TextAlignment="Center"
                                     TextChanged="BackgroundColorTextBox_TextChanged"/>
                            <Border x:Name="BackgroundColorPreview"
                                    Width="42"
                                    Height="28"
                                    Margin="8,0,8,0"
                                    BorderBrush="#808080"
                                    BorderThickness="1"
                                    CornerRadius="3"/>
                            <Button Content="Farbe wählen …"
                                    Padding="12,5"
                                    Margin="0,0,8,0"
                                    Click="ChooseBackgroundColorButton_Click"/>
                            <Button Content="Standard"
                                    Padding="12,5"
                                    Click="ResetBackgroundColorButton_Click"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                            <Button x:Name="SaveSettingsButton" Content="Einstellungen speichern" Padding="16,8" Margin="0,0,8,0" Click="SaveSettingsButton_Click"/>
                            <Button x:Name="CheckUpdatesButton" Content="Nach Updates suchen" Padding="16,8" Click="CheckUpdatesButton_Click"/>
                        </StackPanel>

                        <TextBlock Text="Windows-Dienst" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <CheckBox x:Name="ServiceAutostartCheckBox"
                                  Content="Windows-Dienst automatisch mit Windows starten"
                                  Margin="0,0,0,4"
                                  Checked="ServiceAutostartCheckBox_Changed"
                                  Unchecked="ServiceAutostartCheckBox_Changed"/>
                        <TextBlock Text="Aus = manueller Start möglich. Der Dienst wird nicht deaktiviert."
                                   Foreground="Gray"
                                   Margin="22,0,0,12"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <Ellipse x:Name="ServiceSettingsStatusDot" Width="10" Height="10" Fill="Gray" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ServiceInstalledText" Text="Installiert: wird geprüft …"/>
                        </StackPanel>
                        <TextBlock x:Name="ServiceStateText" Text="Status: wird geprüft …" Margin="18,0,0,12"/>

                        <StackPanel Orientation="Horizontal">
                            <Button Content="Aktualisieren" Padding="12,6" Margin="0,0,8,0" Click="RefreshServiceButton_Click"/>
                            <Button Content="Starten" Padding="12,6" Margin="0,0,8,0" Click="StartServiceButton_Click"/>
                            <Button Content="Stoppen" Padding="12,6" Margin="0,0,8,0" Click="StopServiceButton_Click"/>
                            <Button Content="Neu starten" Padding="12,6" Click="RestartServiceButton_Click"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Über">
                <Grid Margin="28">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="620">
                        <controls:OrdnerSyncLogo Width="128"
                                                 Height="128"
                                                 Margin="0,0,0,18"/>
                        <TextBlock Text="OrdnerSync" FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="AboutVersionText" Margin="0,6,0,16" Foreground="Gray" HorizontalAlignment="Center"/>
                        <TextBlock Text="Synchronisiert Dateien zwischen Ordnern oder USB-Zielen. Einweg oder bidirektional, mit mehreren unabhängigen Jobs."
                                   TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,18"/>
                        <Button Content="GitHub-Projekt öffnen" Padding="16,8" HorizontalAlignment="Center" Click="OpenGitHubButton_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="FooterStatusText" Text="Bereit" Foreground="Gray"/>
            <TextBlock Grid.Column="1" x:Name="VersionText" Text="OrdnerSync" Foreground="Gray"/>
        </Grid>
    </Grid>
</Window>
