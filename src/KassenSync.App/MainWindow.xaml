<Window x:Class="KassenSync.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KassenSync" Height="700" Width="1120" MinHeight="520" MinWidth="860"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="KassenSync" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <TextBlock Text="  Dienststatus: Grundgerüst" Margin="18,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <TabControl Grid.Row="1">
            <TabItem Header="Dateien">
                <Grid Margin="10">
                    <TextBlock Text="Die Dateiübersicht wird in Block 4 angebunden." Foreground="Gray"/>
                </Grid>
            </TabItem>
            <TabItem Header="Einstellungen">
                <Grid Margin="10">
                    <TextBlock Text="Quellordner, Unterordner, Ziellaufwerk, Zielordner, Dateitypen und Autostart folgen in Block 4." TextWrapping="Wrap"/>
                </Grid>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="2" Margin="0,10,0,0" Foreground="Gray"
                   Text="Dienst und GUI sind getrennt; Kommunikation erfolgt über eine Named Pipe."/>
    </Grid>
</Window>
