<Window x:Class="KassenSync.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KassenSync" Height="760" Width="1220" MinHeight="600" MinWidth="980"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="KassenSync" FontSize="26" FontWeight="SemiBold"/>
                <TextBlock x:Name="ServiceStatusText" Text="Dienststatus wird geprüft …" Margin="0,4,0,0" Foreground="Gray"/>
            </StackPanel>
            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                <TextBlock Text="Ziel" Foreground="Gray" HorizontalAlignment="Right"/>
                <TextBlock x:Name="TargetSummaryText" Text="-" FontWeight="SemiBold" HorizontalAlignment="Right"/>
            </StackPanel>
        </Grid>

        <TabControl Grid.Row="1" x:Name="MainTabs">
            <TabItem Header="Dateien">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <Button x:Name="RefreshButton" Content="Aktualisieren" Padding="14,7" Margin="0,0,8,0" Click="RefreshButton_Click"/>
                            <Button x:Name="RecopyButton" Content="Erneut auf Stick kopieren" Padding="14,7" Margin="0,0,8,0" Click="RecopyButton_Click"/>
                            <Button Content="Alles markieren" Padding="14,7" Click="SelectAllButton_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="SelectionText" Text="0 Dateien markiert" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="Gray"/>
                    </DockPanel>

                    <DataGrid Grid.Row="1" x:Name="FilesGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="False"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="✓" Width="44">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Dateiname" Binding="{Binding FileName}" Width="2*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Relativer Pfad" Binding="{Binding RelativePath}" Width="2.4*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Größe" Binding="{Binding Size}" Width="100" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Erkannt" Binding="{Binding DetectedAt}" Width="145" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Zuletzt kopiert" Binding="{Binding LastCopiedAt}" Width="145" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="150" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Ausgaben" Binding="{Binding CopyCount}" Width="85" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Fehler" Binding="{Binding Error}" Width="2*" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Einstellungen">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="18" MaxWidth="900" HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Text="Quelle" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>

                        <TextBlock Grid.Row="1" Text="Quellordner" VerticalAlignment="Center" Margin="0,0,12,10"/>
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="SourceFolderTextBox" Margin="0,0,8,10" VerticalContentAlignment="Center"/>
                        <Button Grid.Row="1" Grid.Column="2" Content="Auswählen …" Padding="12,6" Margin="0,0,0,10" Click="BrowseSourceButton_Click"/>

                        <TextBlock Grid.Row="2" Text="Unterordner" VerticalAlignment="Center" Margin="0,0,12,18"/>
                        <CheckBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" x:Name="IncludeSubdirectoriesCheckBox"
                                  Content="Unterordner ebenfalls überwachen" VerticalAlignment="Center" Margin="0,0,0,18"/>

                        <TextBlock Grid.Row="3" Grid.ColumnSpan="3" Text="Zielmedium" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>

                        <TextBlock Grid.Row="4" Text="Ziellaufwerk" VerticalAlignment="Center" Margin="0,0,12,10"/>
                        <ComboBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" x:Name="TargetDriveComboBox"
                                  IsEditable="True" IsTextSearchEnabled="False" Margin="0,0,0,10" MinWidth="220" HorizontalAlignment="Left" Width="260"/>

                        <TextBlock Grid.Row="5" Text="Ziel-Unterordner" VerticalAlignment="Center" Margin="0,0,12,10"/>
                        <TextBox Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" x:Name="TargetSubfolderTextBox" Margin="0,0,0,10"/>

                        <TextBlock Grid.Row="6" Text="Dateitypen" VerticalAlignment="Top" Margin="0,2,12,10"/>
                        <StackPanel Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,14">
                            <TextBox x:Name="ExtensionsTextBox"/>
                            <TextBlock Text="Mit Komma trennen, z. B. .pdf, .xml, .csv. Leer = alle Dateitypen." Foreground="Gray" Margin="0,4,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="2">
                            <CheckBox x:Name="AutostartCheckBox" Content="KassenSync-GUI bei Windows-Anmeldung starten" Margin="0,0,0,8"/>
                            <CheckBox x:Name="UpdateCheckBox" Content="Beim Start nach Updates suchen" Margin="0,0,0,16"/>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="SaveSettingsButton" Content="Einstellungen speichern" Padding="16,8" Margin="0,0,8,0" Click="SaveSettingsButton_Click"/>
                                <Button x:Name="CheckUpdatesButton" Content="Nach Updates suchen" Padding="16,8" Click="CheckUpdatesButton_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="FooterStatusText" Text="Bereit" Foreground="Gray"/>
            <TextBlock Grid.Column="1" x:Name="VersionText" Text="KassenSync" Foreground="Gray"/>
        </Grid>
    </Grid>
</Window>
