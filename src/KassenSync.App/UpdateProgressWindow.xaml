<Window x:Class="KassenSync.App.UpdateProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KassenSync Update" Width="500" Height="200"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Topmost="True" ShowInTaskbar="False">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="KassenSync wird aktualisiert" FontSize="19" FontWeight="SemiBold"/>
        <TextBlock Grid.Row="1" x:Name="StatusText" Text="Update wird vorbereitet …" Margin="0,14,0,10"/>
        <ProgressBar Grid.Row="2" x:Name="UpdateProgressBar" Height="24" Minimum="0" Maximum="100"/>
        <TextBlock Grid.Row="3" x:Name="PercentText" Text="0 %" Margin="0,8,0,0" HorizontalAlignment="Right" FontWeight="SemiBold"/>
    </Grid>
</Window>
