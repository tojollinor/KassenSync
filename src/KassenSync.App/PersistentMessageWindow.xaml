<Window x:Class="KassenSync.App.PersistentMessageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OrdnerSync"
        Width="540"
        SizeToContent="Height"
        MinHeight="230"
        MaxHeight="520"
        ResizeMode="NoResize"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ShowInTaskbar="False"
        Background="{DynamicResource AppBackgroundBrush}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel HorizontalAlignment="Center">
            <Ellipse x:Name="StatusDot"
                     Width="14"
                     Height="14"
                     Fill="Gray"
                     HorizontalAlignment="Center"
                     Margin="0,0,0,10"/>
            <TextBlock x:Name="TitleText"
                       FontSize="21"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"/>
        </StackPanel>

        <TextBlock Grid.Row="1"
                   x:Name="MessageText"
                   Margin="12,18,12,24"
                   FontSize="15"
                   LineHeight="23"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   HorizontalAlignment="Center"
                   MaxWidth="460"/>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center">
            <Button x:Name="SecondaryButton"
                    MinWidth="150"
                    Height="46"
                    Margin="0,0,10,0"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Visibility="Collapsed"
                    Click="SecondaryButton_Click"/>

            <Button x:Name="PrimaryButton"
                    MinWidth="150"
                    Height="46"
                    FontSize="15"
                    FontWeight="SemiBold"
                    IsDefault="True"
                    Click="PrimaryButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
